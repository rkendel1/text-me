# Neon Postgres — set automatically when you add Neon from the Vercel Marketplace.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/text_me
# Direct connection used for LISTEN/NOTIFY (Neon: DATABASE_URL_UNPOOLED). Falls back to DATABASE_URL.
DATABASE_URL_UNPOOLED=

# Where to get every value: docs/release-audit.md §6.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Optional: the hidden assistant line your real number forwards to (auto-detected if the account has one number).
TWILIO_PHONE_NUMBER=
# Your real mobile number (E.164). Callers keep dialing it.
OWNER_PHONE_NUMBER=
OWNER_ID=owner
# Your access key (openssl rand -base64 32). Devices exchange it for a session.
OWNER_AUTH_TOKEN=

# Optional. On Vercel this defaults to https://<project>.vercel.app.
PUBLIC_BASE_URL=

# Realtime voice through Vercel AI Gateway. On Vercel, OIDC auth is automatic;
# elsewhere set an AI Gateway API key. Set REALTIME_VOICE=off to disable.
AI_GATEWAY_API_KEY=
REALTIME_MODEL=openai/gpt-realtime-2
REALTIME_VOICE_NAME=
TEXT_MODEL=anthropic/claude-haiku-4.5

# Optional: native iOS app notifications (APNs .p8 key). See ios/README.md.
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_PRIVATE_KEY=
APNS_BUNDLE_ID=
APNS_ENVIRONMENT=production
