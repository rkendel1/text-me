# Platform configuration and secrets only. Nothing here names a customer:
# accounts, users, phone numbers and devices live in the database.

# Neon Postgres — set automatically when you add Neon from the Vercel Marketplace.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/text_me
# Direct connection used for LISTEN/NOTIFY (Neon: DATABASE_URL_UNPOOLED). Falls back to DATABASE_URL.
DATABASE_URL_UNPOOLED=

# Optional managed Neon Auth. The Vercel/Neon integration injects this when
# Auth is enabled; it powers Google/Apple buttons and secure OAuth callbacks.
NEON_AUTH_BASE_URL=

# The platform's Twilio account. Its numbers are the pool of assistant lines that
# accounts claim during setup. Where to get every value: docs/release-audit.md §6.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Optional: let accounts buy a new line when the pool is empty (on|off, default off).
TELEPHONY_NUMBER_PURCHASE=
TELEPHONY_SMS_VERIFICATION=

# Optional. On Vercel this defaults to https://<project>.vercel.app.
PUBLIC_BASE_URL=

# Realtime voice through Vercel AI Gateway. On Vercel, OIDC auth is automatic;
# elsewhere set an AI Gateway API key. Set REALTIME_VOICE=off to disable.
AI_GATEWAY_API_KEY=
REALTIME_MODEL=openai/gpt-realtime-2
REALTIME_VOICE_NAME=
TEXT_MODEL=anthropic/claude-haiku-4.5

# Optional Stripe subscriptions. STRIPE_PRODUCT_ID is the prod_... identifier;
# that product must have a recurring default price. The webhook secret is
# required for paid/canceled subscription state changes.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_PRODUCT_ID=
STRIPE_WEBHOOK_SECRET=
# Temporary end-to-end testing only: exactly this account can activate without charging.
BILLING_BYPASS_ACCOUNT_ID=

# Optional: native iOS app notifications (APNs .p8 key). See ios/README.md.
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_PRIVATE_KEY=
APNS_BUNDLE_ID=
APNS_ENVIRONMENT=production
