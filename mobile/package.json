{
  "name": "text-me-mobile",
  "version": "1.0.0",
  "private": true,
  "main": "expo/AppEntry",
  "scripts": {
    "start": "expo start --localhost --port 8081",
    "ios": "node scripts/run-ios.mjs",
    "ios:device": "node scripts/run-ios-device.mjs",
    "ios:prebuild": "expo prebuild --platform ios",
    "android": "expo run:android",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "expo": "~54.0.0",
    "expo-device": "~8.0.0",
    "expo-linking": "~8.0.0",
    "expo-notifications": "~0.32.17",
    "expo-secure-store": "~15.0.0",
    "expo-status-bar": "~3.0.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-web": "^0.21.0",
    "react-native-webview": "13.15.0"
  },
  "devDependencies": {
    "@types/react": "~19.1.10",
    "typescript": "~5.9.2"
  }
}
